# MAGI System × Qoder Cloud Agents — 本地配置
# 复制为 .env.local 后填写。.env.local 已被 .gitignore 排除，不要提交。

# ── 必填：Qoder 个人访问令牌 ─────────────────────────────────
# Qoder 控制台 → 设置 → 个人访问令牌 → 创建令牌（pt- 开头，只显示一次）
QODER_PAT=pt-your-token-here

# 服务端地址。CN 账号用 api.qoder.com.cn；国际版改成 https://api.qoder.com
QODER_API_ORIGIN=https://api.qoder.com.cn

# ── 三台主机各自的模型（异构才有意义）───────────────────────
# 先跑 `npm run bootstrap` 查看本账号可用的 model id，再填这里。
# 不填则 bootstrap 从可用列表里按顺序取三个不同的。
# MAGI_MODEL_MELCHIOR=
# MAGI_MODEL_BALTHASAR=
# MAGI_MODEL_CASPER=

# ── 裁决节奏 ────────────────────────────────────────────────
# 单台主机从发问到拿到答复的等待上限（毫秒），默认 150000
MAGI_DEADLINE_MS=150000
# 轮询事件历史的间隔（毫秒），默认 1200
MAGI_POLL_INTERVAL_MS=1200
# per_query（默认，每次审议新建 Session，三台主机不留记忆）
# persistent（复用 Session，主机会记住之前的裁决 —— 更接近原作，但有污染风险）
MAGI_SESSION_MODE=per_query

# ── 调试 ────────────────────────────────────────────────────
# 置 1 时把每台主机这一轮的原始事件写到 .magi-debug/<unit>-<session>.json
MAGI_DEBUG=0

# ── 离线演示 / 回归用（不接真实模型，不花额度）──────────────
# MAGI_PROVIDER=mock
# MAGI_MOCK_VOTES=APPROVE,REJECT,APPROVE        # 三台，按 MELCHIOR,BALTHASAR,CASPER 顺序
# MAGI_MOCK_CRITICAL=0,0,0                       # 1 表示该台把议题标为重大议题
# MAGI_MOCK_LATENCY_MS=120
# MAGI_MOCK_MODEL=fake-sage

# Daily usage guard (best effort; 0 disables it). Configure reverse-proxy auth/rate limits for public use.
MAGI_DAILY_CREDIT_CAP=500

# Optional build-time path prefix. Leave unset to serve at /.
# MAGI_BASE_PATH=/maji
